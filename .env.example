# Copy to .env and adjust. Every setting is optional - defaults work offline.
# Relative paths are resolved from the project root.

SIA_DATABASE_PATH=data/irrigation.db
SIA_MODEL_PATH=models/irrigation_model.joblib
SIA_DATA_DIR=data
SIA_REPORTS_DIR=reports
SIA_LOG_DIR=logs
SIA_LOG_LEVEL=INFO

# Shared secret required in the X-Device-Key header of /api/v1/iot/ingest.
# Leave empty to disable (fine for a local demo; set it for any networked deployment).
SIA_IOT_API_KEY=

# Weather: "simulated" (offline) or "openmeteo" (live forecast + Penman-Monteith ET0; needs internet,
# falls back to simulated when unreachable)
SIA_WEATHER_PROVIDER=simulated
SIA_DEFAULT_LONGITUDE=79.49244
SIA_TIMEZONE=Asia/Kolkata
SIA_CLIMATE_PROFILE=semi_arid_monsoon
SIA_DEFAULT_LATITUDE=18.5
# Offset used to convert timezone-aware timestamps (e.g. ESP32 epoch seconds) to field-local time
SIA_UTC_OFFSET_HOURS=5.5

# Engine behaviour
SIA_HISTORY_HOURS=72
SIA_STALE_READING_HOURS=6
